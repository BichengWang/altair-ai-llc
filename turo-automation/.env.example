# Turo Automation — Environment Variables
#
# Copy this file to .env (gitignored) and fill in your values.
# The app falls back to fixture data when Supabase variables are absent.

# ---------------------------------------------------------------------------
# Supabase — required for real persistence
# ---------------------------------------------------------------------------
# Worker reads these at runtime (Node process.env):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-or-anon-key>

# Web reads these at Vite build time (must be prefixed VITE_):
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=<anon-key>

# ---------------------------------------------------------------------------
# Slack — optional; enables real notifications
# ---------------------------------------------------------------------------
# Incoming webhook URL from a Slack app installation.
# When absent, the notifier is a no-op and jobs run silently.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<T>/<B>/<token>
